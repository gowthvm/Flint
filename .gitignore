# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
# Built native extension — *.py[cod] catches it only by accident ([cod] includes d)
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# PyInstaller
*.manifest
# keep .spec files (they are part of the repo)

# Virtual environments
.venv/
venv/
ENV/

# Installer logs and coverage
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.coverage
.coverage.*

# Pytest
.pytest_cache/

# mypy
.mypy_cache/

# Ruff lint cache (ruff also self-ignores it; belt-and-braces)
.ruff_cache/

# Editor directories and workspace files
.vscode/
*.code-workspace
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini
._*

# Logs and temporary files
*.log
*.tmp
tmp/
temp/

# Wheels
*.whl

# Local build-validation output folder (wheels, reports)
/dist-validation/

# Secrets and signing material (never commit these)
*.pfx
*.key
*.pem
*.cer
.env
# Per-environment secret files (.env.local, .env.production, ...)
.env.*

# Local CI / artifacts folder (do not commit built EXEs)
flint-dist/

# Stray binaries and disk images dropped in the working tree
# (built EXEs normally land in dist/ or flint-dist/; test images are huge)
*.exe
*.iso
*.img
*.vhdx

# Local planning docs (not for the public repo)
TODO.md
PLAN.md
AGENTS.md

# Internal source-of-truth documentation (never publish)
SOURCE_OF_TRUTH/

.aider*
